<?xml version="1.0" encoding="utf-8"?>
<!-- namespace khai bao trong app/build.gradle.kts (AGP 8 khong nhan thuoc tinh package o day) -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Mo lai app khi may khoi dong lai giua gio thi (BootReceiver) -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- An cua so noi cua app khac (bong bong chat Messenger...) de len app thi (Android 12+) -->
    <uses-permission android:name="android.permission.HIDE_OVERLAY_WINDOWS" />

    <!-- usesCleartextTraffic: cho phep http:// trong mang noi bo (vd: may chu 192.168.x.x:3000).
         Dung tren Vercel (https://) thi khong can, nhung de bat cung khong anh huong. -->
    <application
        android:allowBackup="false"
        android:label="Safe Exam"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.AppCompat.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Device Owner: adb shell dpm set-device-owner com.safe.exam/.AdminReceiver -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
