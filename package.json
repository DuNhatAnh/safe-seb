{
  "name": "safe-seb",
  "version": "2.0.0",
  "description": "Safe Exam - Kiosk lockdown and exam monitoring",
  "main": "server.ts",
  "scripts": {
    "start": "node server.ts",
    "dev": "node scripts/db.ts migrate --if-configured && node --watch-path=server.ts --watch-path=lib --watch-path=.env server.ts --dev",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json",
    "build": "node scripts/db.ts migrate --if-configured && tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm test && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "npm test && npm run test:e2e",
    "db:status": "node scripts/db.ts status",
    "db:migrate": "node scripts/db.ts migrate",
    "db:new": "node scripts/db.ts new",
    "exam:import": "node scripts/import-exam.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.17",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
