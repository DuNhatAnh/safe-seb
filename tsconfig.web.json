{
  // Chi KIEM TRA (khong bien dich) JS chay tren trinh duyet: public/js/*.js
  // Cac file nap bang <script> nen dung chung pham vi global, tsc hieu duoc ham goi cheo giua cac file.
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2023", "dom", "dom.iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "types": []
  },
  "files": [
    "public/js/types.d.ts",
    "public/js/app.js",
    "public/js/question-types.js",
    "public/js/lockdown.js",
    "public/js/exam.js",
    "public/js/admin.js"
  ]
}
