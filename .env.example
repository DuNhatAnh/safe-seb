# Sao chep thanh .env (chay local) hoac khai bao o Vercel > Project > Settings > Environment Variables
SUPABASE_URL=https://twavyhrlphhqsqiqvrzq.supabase.co
# Supabase > Project Settings > API Keys > service_role / secret key. TUYET DOI khong dua vao public/
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASSWORD=
PROCTOR_PASSWORD=
# Chuoi ngau nhien dai, vd: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# (Tuy chon) Postgres de tu chay migration database/migrations (npm run db:migrate, npm run dev, build Vercel).
# Supabase > nut "Connect" > "Session pooler" > chep URI, thay [YOUR-PASSWORD] bang mat khau database.
# Vd: postgresql://postgres.<ref>:<mat-khau>@aws-0-<vung>.pooler.supabase.com:5432/postgres
DATABASE_URL=
